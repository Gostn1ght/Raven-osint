# ═══════════════════════════════════════════════════════════════════════════════
# Ravens Nexus — Server Environment
# Copy to .env (or set as real environment variables on your host / Replit).
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────────────────────────
RAVENS_SERVER_PORT=3000

# ── Security secrets (REQUIRED in production) ────────────────────────────────────
# If any of these are unset, the server generates a random per-process value and
# prints it to the log at startup (fine for local dev, NOT for production).
#   - RAVENS_ADMIN_SECRET : gate for the admin panel & admin API (x-admin-secret header)
#   - RAVENS_JWT_SECRET   : signs session tokens issued at activation
#   - RAVENS_HMAC_SECRET  : signs server responses (anti-tamper)
RAVENS_ADMIN_SECRET=CHANGE_ME_use_a_long_random_string
RAVENS_JWT_SECRET=CHANGE_ME_32+_random_hex_chars
RAVENS_HMAC_SECRET=CHANGE_ME_32+_random_hex_chars

# ── OSINT provider keys (OPTIONAL — enable premium modules) ──────────────────────
# OSINT runs on the SERVER, so these keys stay on the backend and never reach clients.
# Modules degrade gracefully to dork/link generation when a key is absent.
NVIDIA_NIM_API_KEY=            # AI module (nvapi-...)
INTELX_API_KEY=               # IntelX module
HIBP_API_KEY=                 # HaveIBeenPwned (raises rate limits)
VERIPHONE_API_KEY=            # Phone OSINT

# ── Discord bot (OPTIONAL) ───────────────────────────────────────────────────────
# Powers the admin Discord-gateway monitor AND the Discord OSINT lookup tab.
# Without it, Discord lookups return only the account-creation date derived from the ID.
DISCORD_BOT_TOKEN=
