language = "rust"
run = "cargo run --release -p ravens-server"
modules = ["rust-stable"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 5000

[env]
RAVENS_SERVER_PORT = "3000"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cargo run --release -p ravens-server"
waitForPort = 5000

[userenv]

[userenv.shared]
RAVENS_SERVER_PORT = "5000"
