# ══════════════════════════════════════════════════════════════════
# Ravens Nexus — Server Configuration
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════

# Server
PORT=8080
DATABASE_URL=sqlite://ravens.db

# Security (generate with: openssl rand -hex 64)
JWT_SECRET=change-me-to-64-char-random-hex-string
ADMIN_TOKEN=change-me-admin-token

# ── Optional External APIs ─────────────────────────────────────────

# HIBP (HaveIBeenPwned) — https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Lenso.ai reverse image search
LENSO_API_KEY=

# Picarta — image geolocation — https://picarta.ai
PICARTA_API_KEY=

# OpenAI
OPENAI_API_KEY=

# NVIDIA NIM (alternative AI endpoint)
NVIDIA_NIM_API_KEY=

# ── Payments ───────────────────────────────────────────────────────

# YooMoney wallet number (receiver of payments)
YOOMONEY_TOKEN=

# Cryptomus — https://cryptomus.com
CRYPTOMUS_MERCHANT=
CRYPTOMUS_API_KEY=

# ── Logging ────────────────────────────────────────────────────────
RUST_LOG=ravens_server=info,tower_http=info
